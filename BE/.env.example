# Environment
NODE_ENV=development
PORT=5000

# MongoDB
MONGO_URI=mongodb://localhost:27017/cloneharavan

# Client URL (for CORS)
CLIENT_URL=http://localhost:3000

# JWT – Access Token (short-lived)
JWT_SECRET=your_access_token_secret_change_in_production
JWT_EXPIRES_IN=15m

# JWT – Refresh Token (long-lived)
REFRESH_TOKEN_SECRET=your_refresh_token_secret_change_in_production
REFRESH_TOKEN_EXPIRES_IN=7d

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email SMTP (Nodemailer - Optional in dev, falls back to console log)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM="Haravan Clone <noreply@yourdomain.com>"

