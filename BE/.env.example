# Environment
NODE_ENV=development
PORT=5000

# MongoDB
MONGO_URI=mongodb://localhost:27017/cloneharavan

# Client URL (for CORS)
CLIENT_URL=http://localhost:3000

# JWT – Access Token (short-lived)
JWT_SECRET=your_access_token_secret_change_in_production
JWT_EXPIRES_IN=15m

# JWT – Refresh Token (long-lived)
REFRESH_TOKEN_SECRET=your_refresh_token_secret_change_in_production
REFRESH_TOKEN_EXPIRES_IN=7d

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email SMTP (Nodemailer - Optional in dev, falls back to console log)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
# Admin Secret Key (dùng cho API tạo tài khoản admin ban đầu)
ADMIN_SECRET_KEY=your_admin_secret_key_change_in_production

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id

# TikTok Login Kit / OAuth
TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret
TIKTOK_REDIRECT_URI=http://localhost:3000/auth/tiktok/callback

# Zalo OAuth 2.0 PKCE Login
ZALO_APP_ID=your_zalo_app_id
ZALO_APP_SECRET=your_zalo_app_secret
ZALO_REDIRECT_URI=http://localhost:3000/auth/zalo/callback

# AI Logistics Specs Extractor (SearXNG -> Google CSE / Ollama -> Gemini -> Groq)
SEARXNG_URL=http://localhost:8080
GOOGLE_CSE_API_KEY=your_google_cse_api_key
GOOGLE_CSE_ID=your_google_cse_search_engine_id
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_MS=18000
GEMINI_API_KEY=your_gemini_api_key
GROQ_API_KEY=your_groq_api_key

