{
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2022",
    "moduleResolution": "node",
    "baseUrl": "./",
    "paths": {
      "*": [
        "BE/node_modules/*",
        "client/node_modules/*",
        "Admin/node_modules/*"
      ]
    },
    "checkJs": false
  },
  "exclude": [
    "**/node_modules",
    "**/dist",
    "**/build",
    "**/public"
  ]
}
